# Application Environment Configuration Template
# Copy to .env and fill in values. Never commit .env.

# Wallet login (Privy)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# AI providers for Cokoo advisor (/api/advisor) and Agent Hall rebalance (/api/rebalance).
# Set at least one key; providers are tried in order Gemini → DeepSeek → MuseSpark.
# Without any key, AI reviews/plans return an explicit "unavailable" error (no fabricated plans).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
MUSESPARK_API_KEY=
MUSESPARK_BASE_URL=https://api.musespark.ai/v1
MUSESPARK_MODEL=muse-spark-1.3

# Optional: identifying app name + contact for SEC EDGAR fair-access
SEC_USER_AGENT=

# Binance Web3 RWA Data (spread monitor, session clock, RWA passport, sector tabs).
# Free API access during the hackathon. Without these keys the RWA surfaces
# stay hidden and the game keeps its xStocks/Yahoo chain. Never commit .env.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# BSC chain id used for RWA token resolution (56 = mainnet, 97 = testnet).
BINANCE_WEB3_RWA_CHAIN_ID=56
